# ==============================================================================
# StockGuard Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or configure in your deployment platform.
# NEVER commit .env or real production credentials to version control.
# ==============================================================================

# Backend Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Primary PostgreSQL Database Configuration (Flyway Managed)
# Option A: Local Docker or Native PostgreSQL instance:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockguard
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Option B: Hosted Cloud PostgreSQL (e.g. Supabase / Neon / Render)
# Use Transaction Pooler (Port 6543) or Session Mode (Port 5432) with SSL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
# SPRING_DATASOURCE_PASSWORD=your-secure-database-password

# Flyway Database Migration Engine
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# Security & Stateless JWT Authentication
# Ensure JWT_SECRET is at least 256 bits (32+ alphanumeric characters)
JWT_SECRET=stockguard_default_dev_secret_key_replace_in_production_32chars!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: PostgreSQL Integration Test Configuration (Phase 6 Testcontainers Override)
# If Docker is unavailable locally, specify a dedicated test PostgreSQL instance:
# STOCKGUARD_TEST_POSTGRES_URL=jdbc:postgresql://localhost:5432/stockguard_test
# STOCKGUARD_TEST_POSTGRES_USER=testuser
# STOCKGUARD_TEST_POSTGRES_PASSWORD=testpassword
# STOCKGUARD_ENFORCE_POSTGRES_TESTS=false

# ==============================================================================
# Frontend Client Configuration (Vite)
# ==============================================================================
# Client environment variables exposed to Vite must be prefixed with VITE_
VITE_API_BASE_URL=http://localhost:8080/api/v1
